rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow create: if isValidLead();
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    function isValidLead() {
      return request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'product',
          'message',
          'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.product is string
        && request.resource.data.product.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 800
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
    }
  }
}
